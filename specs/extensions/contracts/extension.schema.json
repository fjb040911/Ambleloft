{
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "specVersion": {
      "const": "1.0-draft"
    },
    "publisher": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 60
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 60
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "engines": {
      "type": "object",
      "properties": {
        "api": {
          "const": "1"
        }
      },
      "required": [
        "api"
      ],
      "additionalProperties": false
    },
    "main": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*:)[A-Za-z0-9_.@/-]+$"
    },
    "activationEvents": {
      "type": "array",
      "items": {
        "enum": [
          "onStartupFinished"
        ]
      },
      "maxItems": 1,
      "uniqueItems": true
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "capability": {
            "enum": [
              "projects.read",
              "projects.path.read",
              "conversations.create",
              "conversations.open",
              "storage",
              "configuration",
              "secrets"
            ]
          },
          "scope": {
            "enum": [
              "project",
              "self"
            ]
          }
        },
        "required": [
          "capability",
          "scope"
        ],
        "additionalProperties": false
      },
      "maxItems": 10,
      "uniqueItems": true
    },
    "operations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/operation"
      },
      "maxItems": 50,
      "uniqueItems": true
    },
    "contributes": {
      "type": "object",
      "properties": {
        "home": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "webRoot": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*:)[A-Za-z0-9_.@/-]+$"
            },
            "entry": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*:)[A-Za-z0-9_.@/-]+$"
            },
            "when": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "required": [
            "title",
            "webRoot",
            "entry"
          ],
          "additionalProperties": false
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+\\.[A-Za-z][A-Za-z0-9_-]*$",
                "maxLength": 180
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "action": {
                "const": "openHome"
              },
              "when": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "required": [
              "id",
              "title",
              "action"
            ],
            "additionalProperties": false
          },
          "maxItems": 20,
          "uniqueItems": true
        },
        "mcpApps": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "properties": {
              "uri": {
                "type": "string",
                "pattern": "^ui://[A-Za-z0-9][A-Za-z0-9._/-]*$",
                "maxLength": 512
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "entry": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*:)[A-Za-z0-9_.@/-]+$"
              },
              "mimeType": {
                "const": "text/html;profile=mcp-app"
              }
            },
            "required": [
              "uri",
              "title",
              "entry",
              "mimeType"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*:)[A-Za-z0-9_.@/-]+$"
      },
      "maxItems": 20,
      "uniqueItems": true
    },
    "configuration": {
      "allOf": [
        {
          "$ref": "#/$defs/valueSchema"
        },
        {
          "properties": {
            "type": {
              "const": "object"
            }
          }
        }
      ]
    },
    "contextKeys": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "type": {
            "enum": [
              "boolean",
              "string",
              "number"
            ]
          },
          "default": {
            "type": [
              "boolean",
              "string",
              "number"
            ]
          }
        },
        "required": [
          "key",
          "type",
          "default"
        ],
        "additionalProperties": false
      },
      "maxItems": 50,
      "uniqueItems": true
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resources"
      ],
      "properties": {
        "resources": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "baseUrl",
              "audience",
              "scopes"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-zA-Z0-9.-]{0,63}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "baseUrl": {
                "type": "string",
                "pattern": "^https://",
                "maxLength": 2048
              },
              "audience": {
                "type": "string",
                "pattern": "^https://",
                "maxLength": 2048
              },
              "scopes": {
                "type": "array",
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[!-~]+$",
                  "maxLength": 256
                }
              }
            }
          }
        }
      }
    },
    "icon": {
      "description": "Package-relative static PNG icon, or explicit light/dark variants.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[A-Za-z0-9_-]+(?:/[A-Za-z0-9_.-]+)*\\.png$"
        },
        {
          "type": "object",
          "properties": {
            "light": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240,
              "pattern": "^[A-Za-z0-9_-]+(?:/[A-Za-z0-9_.-]+)*\\.png$"
            },
            "dark": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240,
              "pattern": "^[A-Za-z0-9_-]+(?:/[A-Za-z0-9_.-]+)*\\.png$"
            }
          },
          "required": [
            "light",
            "dark"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "specVersion",
    "publisher",
    "name",
    "version",
    "displayName",
    "engines"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ambleloft Extension M1 draft manifest",
  "$defs": {
    "valueSchema": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "object",
            "array",
            "string",
            "number",
            "integer",
            "boolean",
            "null"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "properties": {
          "type": "object",
          "maxProperties": 100,
          "additionalProperties": {
            "$ref": "#/$defs/valueSchema"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "additionalProperties": {
          "const": false
        },
        "items": {
          "$ref": "#/$defs/valueSchema"
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        },
        "minLength": {
          "type": "integer",
          "minimum": 0
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "minItems": {
          "type": "integer",
          "minimum": 0
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "object"
              }
            }
          },
          "then": {
            "required": [
              "properties",
              "additionalProperties"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "array"
              }
            }
          },
          "then": {
            "required": [
              "items",
              "maxItems"
            ]
          }
        }
      ]
    },
    "operation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+\\.[A-Za-z][A-Za-z0-9_-]*$",
          "maxLength": 180
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "handler": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "exposeTo": {
          "type": "array",
          "items": {
            "enum": [
              "page",
              "agent"
            ]
          },
          "maxItems": 2,
          "uniqueItems": true
        },
        "effect": {
          "enum": [
            "read",
            "write"
          ]
        },
        "projectScoped": {
          "type": "boolean"
        },
        "inputSchema": {
          "allOf": [
            {
              "$ref": "#/$defs/valueSchema"
            },
            {
              "properties": {
                "type": {
                  "const": "object"
                }
              }
            }
          ]
        },
        "outputSchema": {
          "allOf": [
            {
              "$ref": "#/$defs/valueSchema"
            },
            {
              "properties": {
                "type": {
                  "const": "object"
                }
              }
            }
          ]
        },
        "requiredPermissions": {
          "type": "array",
          "items": {
            "enum": [
              "projects.read",
              "projects.path.read",
              "conversations.create",
              "conversations.open",
              "storage",
              "configuration",
              "secrets"
            ]
          },
          "maxItems": 10,
          "uniqueItems": true
        },
        "enablement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000
        },
        "risk": {
          "type": "object",
          "properties": {
            "reversible": {
              "type": "boolean"
            },
            "impacts": {
              "type": "array",
              "items": {
                "enum": [
                  "external",
                  "destructive",
                  "bulk",
                  "permissions"
                ]
              },
              "uniqueItems": true,
              "maxItems": 4
            }
          },
          "required": [
            "reversible",
            "impacts"
          ],
          "additionalProperties": false
        },
        "_meta": {
          "type": "object",
          "properties": {
            "ui": {
              "type": "object",
              "properties": {
                "resourceUri": {
                  "type": "string",
                  "maxLength": 512
                }
              },
              "required": [
                "resourceUri"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "ui"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "handler",
        "exposeTo",
        "effect",
        "projectScoped",
        "inputSchema",
        "outputSchema"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "operations"
        ],
        "properties": {
          "operations": {
            "minItems": 1
          }
        }
      },
      "then": {
        "required": [
          "main"
        ]
      }
    },
    {
      "if": {
        "required": [
          "activationEvents"
        ],
        "properties": {
          "activationEvents": {
            "minItems": 1
          }
        }
      },
      "then": {
        "required": [
          "main"
        ]
      }
    }
  ],
  "$id": "urn:amble:extension-manifest"
}
