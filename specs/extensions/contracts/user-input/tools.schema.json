{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ambleloft.dev/contracts/user-input/v1/tools.schema.json",
  "title": "User input v1 internal model tool contract",
  "$defs": {
    "field": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,79}$"
        },
        "type": {
          "enum": [
            "text",
            "textarea",
            "number",
            "money",
            "date",
            "select",
            "checkbox",
            "switch"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "required": {
          "type": "boolean"
        },
        "help": {
          "type": "string",
          "maxLength": 2000
        },
        "placeholder": {
          "type": "string",
          "maxLength": 200
        },
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20000
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20000
        },
        "minimum": {
          "type": [
            "number",
            "string"
          ]
        },
        "maximum": {
          "type": [
            "number",
            "string"
          ]
        },
        "integer": {
          "type": "boolean"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "scale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "required": [
              "label",
              "value"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "name",
        "type",
        "label"
      ],
      "additionalProperties": false
    },
    "definition": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/field"
          }
        }
      },
      "required": [
        "title",
        "fields"
      ],
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "dynamic"
                },
                "definition": {
                  "$ref": "#/$defs/definition"
                }
              },
              "required": [
                "kind",
                "definition"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "template"
                },
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "required": [
                "kind",
                "key"
              ],
              "additionalProperties": false
            }
          ]
        },
        "prefill": {
          "type": "object",
          "maxProperties": 12,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "requestKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "reason",
        "source",
        "requestKey"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "name": {
          "const": "input_capabilities"
        },
        "arguments": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "name": {
          "const": "input_list"
        },
        "arguments": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "name": {
          "const": "input_request"
        },
        "arguments": {
          "$ref": "#/$defs/request"
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "name": {
          "const": "input_read_answer"
        },
        "arguments": {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "requestId"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "name": {
          "const": "input_cancel"
        },
        "arguments": {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "expectedRevision": {
              "type": "integer",
              "minimum": 0
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [
            "requestId",
            "expectedRevision",
            "reason"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "name": {
          "const": "input_replace"
        },
        "arguments": {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "expectedRevision": {
              "type": "integer",
              "minimum": 0
            },
            "replacement": {
              "$ref": "#/$defs/request"
            }
          },
          "required": [
            "requestId",
            "expectedRevision",
            "replacement"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "name": {
          "const": "input_resolve_from_message"
        },
        "arguments": {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "expectedRevision": {
              "type": "integer",
              "minimum": 0
            },
            "sourceMessageIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "values": {
              "type": "object",
              "maxProperties": 12,
              "propertyNames": {
                "pattern": "^[a-z][a-z0-9-]{0,79}$"
              },
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            }
          },
          "required": [
            "requestId",
            "expectedRevision",
            "sourceMessageIds",
            "values"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    }
  ]
}
