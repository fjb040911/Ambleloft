{
  "openapi": "3.1.0",
  "info": {
    "title": "云桥设备维修系统 · 测试 API",
    "version": "1.0.0",
    "description": "虚构业务、真实 HTTP。API Key 在扩展凭据设置中配置。业务规则见01-api-guide.md与02-business-rules.md；设备例子不是永久字典。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:47835",
      "description": "本机演示，可在扩展设置替换"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "服务健康检查",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "const": "ok"
                        },
                        "mode": {
                          "const": "synthetic-demo"
                        },
                        "version": {
                          "const": "1.0.0"
                        }
                      },
                      "required": [
                        "status",
                        "mode",
                        "version"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "错误；参阅接口指南的 HTTP 状态及 code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "currentUser",
        "summary": "查看当前身份",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/User"
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "错误；参阅接口指南的 HTTP 状态及 code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/devices": {
      "get": {
        "operationId": "listDevices",
        "summary": "查询设备",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Device"
                          }
                        },
                        "total": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "nextOffset": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "items",
                        "total",
                        "nextOffset"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "错误；参阅接口指南的 HTTP 状态及 code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "retired"
              ]
            }
          }
        ]
      }
    },
    "/api/v1/tickets": {
      "post": {
        "operationId": "createTicket",
        "summary": "登记维修工单",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Ticket"
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "201": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Ticket"
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "错误；参阅接口指南的 HTTP 状态及 code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          },
          {
            "name": "X-Demo-Fault",
            "in": "header",
            "description": "仅 DEMO_FAULTS=1 下测试；提交入库后返回503。非业务字段。",
            "schema": {
              "type": "string",
              "enum": [
                "after-commit"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TicketInput"
              },
              "example": {
                "deviceId": "dev-printer-01",
                "summary": "三楼打印机持续卡纸",
                "description": "今天上午连续三次打印均卡纸，重启后仍然出现。",
                "priority": "normal"
              }
            }
          }
        },
        "description": "新提交201；同一标识同内容200；不同内容409。创建人与时间由服务提供。16 KiB 限制。提交标识与工单持久化，无自动过期。结果不明先调用getSubmission；禁止换新标识自动重发。"
      },
      "get": {
        "operationId": "listTickets",
        "summary": "查询我的工单",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Ticket"
                          }
                        },
                        "total": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "nextOffset": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "items",
                        "total",
                        "nextOffset"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "错误；参阅接口指南的 HTTP 状态及 code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ]
      }
    },
    "/api/v1/tickets/{ticketId}": {
      "get": {
        "operationId": "getTicket",
        "summary": "查看工单",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Ticket"
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "错误；参阅接口指南的 HTTP 状态及 code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "ticketId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        ]
      }
    },
    "/api/v1/submissions/{submissionId}": {
      "get": {
        "operationId": "getSubmission",
        "summary": "核查不明确的提交结果",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Recovery"
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "错误；参阅接口指南的 HTTP 状态及 code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "submissionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          }
        ],
        "description": "使用原 Idempotency-Key；未找到返回unknown，不代表notExecuted。已入库返回succeeded和ticket，不重发写入。"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "演示服务账号对应demo-employee；非企业认证"
      }
    },
    "schemas": {
      "TicketInput": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "summary": {
            "type": "string",
            "minLength": 5,
            "maxLength": 100,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "maxLength": 2000,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "priority": {
            "type": "string",
            "enum": [
              "normal",
              "urgent"
            ],
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "impactReason": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "contactEmail": {
            "type": "string",
            "minLength": 3,
            "maxLength": 254,
            "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
          }
        },
        "required": [
          "deviceId",
          "summary",
          "description",
          "priority"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "priority": {
                  "const": "urgent"
                }
              }
            },
            "then": {
              "required": [
                "impactReason"
              ]
            }
          }
        ],
        "description": "字符串无首尾空白；可选字段无值时省略，不发送空字符串/null。紧急必须说明影响。"
      },
      "Ticket": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "summary": {
            "type": "string",
            "minLength": 5,
            "maxLength": 100,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "maxLength": 2000,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "priority": {
            "type": "string",
            "enum": [
              "normal",
              "urgent"
            ],
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "impactReason": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "contactEmail": {
            "type": "string",
            "minLength": 3,
            "maxLength": 254,
            "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^TKT-[0-9a-f-]{36}$"
          },
          "deviceName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "status": {
            "type": "string",
            "enum": [
              "submitted"
            ]
          },
          "createdBy": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "createdAt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
          }
        },
        "required": [
          "deviceId",
          "summary",
          "description",
          "priority",
          "id",
          "deviceName",
          "status",
          "createdBy",
          "contactEmail",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "Device": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "retired"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "location",
          "status"
        ],
        "additionalProperties": false
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "email": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "id",
          "displayName",
          "email"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "field": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "Recovery": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "succeeded"
              },
              "ticket": {
                "$ref": "#/components/schemas/Ticket"
              }
            },
            "required": [
              "status",
              "ticket"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "unknown"
              }
            },
            "required": [
              "status"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  }
}
