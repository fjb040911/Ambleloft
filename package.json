{
  "name": "ambleloft",
  "version": "0.3.1",
  "private": true,
  "description": "Open-source, extensible desktop Agent workspace",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "icons:generate": "node scripts/generate-icons.mjs",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "playwright test",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "test:codex": "node scripts/test-codex.cjs",
    "test:credentials": "node scripts/test-credential-restart.mjs",
    "test:mermaid": "node scripts/test-mermaid-copy.mjs",
    "test:chat-bridge": "node scripts/test-chat-bridge.cjs",
    "test:files": "node scripts/test-project-files.mjs",
    "prebuild": "node scripts/prepare-pdf-assets.mjs && node scripts/prepare-office.mjs && npm run extensions:bundle",
    "predev": "node scripts/prepare-pdf-assets.mjs",
    "predev:web": "node scripts/prepare-pdf-assets.mjs",
    "engine:prepare": "node scripts/prepare-engine.cjs",
    "package:mac": "npm run engine:prepare && npm run build && electron-builder --config build/electron-builder.cjs --mac --dir",
    "dist:mac": "npm run package:mac && node scripts/create-mac-artifacts.cjs",
    "release:mac": "ATELIER_RELEASE=1 npm run dist:mac",
    "test:packaged": "node scripts/test-packaged.mjs",
    "test:office": "node scripts/test-office-preview.mjs",
    "extensions:validate": "node scripts/validate-extension.cjs",
    "test:extensions:engine": "node scripts/probes/extension-engine.cjs",
    "test:extensions:electron": "electron scripts/probes/extension-electron.cjs",
    "extensions:bundle": "node scripts/prepare-extension-validator.cjs",
    "test:extensions:packaged": "node scripts/probes/package-extension-probe.cjs",
    "test:extensions:packages": "node scripts/test-extension-packages.mjs",
    "test:extensions:hosts": "node scripts/test-extension-hosts.mjs",
    "test:extensions:pages": "node scripts/test-extension-pages.mjs",
    "test:extensions:operations": "node scripts/test-extension-operations.mjs",
    "test:extensions:mcp": "node scripts/probes/extension-engine.cjs --mcp",
    "extensions:sdk": "node scripts/build-extension-sdk.cjs && npm pack ./packages/extension-sdk --pack-destination ./dist/sdk --ignore-scripts",
    "extensions:demo": "node scripts/build-extension-sdk.cjs && tsc -p examples/extensions/project-card/tsconfig.json && node scripts/build-extension-demo.cjs",
    "extensions:pack": "node scripts/pack-extension.cjs",
    "test:extensions:demo": "node scripts/test-extension-demo.mjs",
    "test:extensions:sdk-package": "node scripts/test-extension-sdk-package.cjs",
    "test:extensions:apps": "node scripts/test-mcp-apps.mjs",
    "test:forms": "node --test tests/forms.test.cjs && node scripts/test-declarative-forms.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.15",
    "echarts": "^6.1.0",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "katex": "^0.18.7",
    "lucide-react": "^0.468.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mermaid": "^11.17.2",
    "openid-client": "^6.8.8",
    "pako": "^3.0.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.1",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@openai/codex": "0.153.4",
    "@playwright/test": "^1.51.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "ajv": "8.20.0",
    "electron": "41.10.7",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.2.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/fjb040911/Ambleloft.git"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
