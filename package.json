{
  "name": "ambleloft",
  "version": "0.2.1",
  "private": true,
  "description": "Open-source, extensible desktop Agent workspace",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "icons:generate": "node scripts/generate-icons.mjs",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "playwright test",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "test:codex": "node scripts/test-codex.cjs",
    "test:credentials": "node scripts/test-credential-restart.mjs",
    "test:mermaid": "node scripts/test-mermaid-copy.mjs",
    "test:chat-bridge": "node scripts/test-chat-bridge.cjs",
    "test:files": "node scripts/test-project-files.mjs",
    "prebuild": "node scripts/prepare-pdf-assets.mjs",
    "predev": "node scripts/prepare-pdf-assets.mjs",
    "predev:web": "node scripts/prepare-pdf-assets.mjs",
    "engine:prepare": "node scripts/prepare-engine.cjs",
    "package:mac": "npm run engine:prepare && npm run build && electron-builder --config build/electron-builder.cjs --mac --dir",
    "dist:mac": "npm run package:mac && node scripts/create-mac-artifacts.cjs",
    "release:mac": "ATELIER_RELEASE=1 npm run dist:mac",
    "test:packaged": "node scripts/test-packaged.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "dompurify": "^3.4.15",
    "echarts": "^6.1.0",
    "katex": "^0.18.7",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.17.2",
    "pako": "^3.0.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@openai/codex": "0.153.4",
    "@playwright/test": "^1.51.0",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "41.10.7",
    "electron-builder": "26.15.3",
    "typescript": "^5.7.0",
    "vite": "^6.2.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/fjb040911/Ambleloft.git"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
